PORT=4000

# Configuración de Telegram MTProto (GramJS) - Bóveda Indestructible
# Obtén TELEGRAM_API_ID y TELEGRAM_API_HASH en https://my.telegram.org (sección "API development tools")
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Token de bot creado en @BotFather
TELEGRAM_BOT_TOKEN=

# ID del canal o supergrupo privado donde se almacenarán los episodios (ej: -1001234567890 o @micanal)
TELEGRAM_CHANNEL_ID=
