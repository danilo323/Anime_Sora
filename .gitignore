# ==========================================
# Git Ignore - Sora Anime (AnimeDex)
# ==========================================

# Dependencias
node_modules/
**/node_modules/
.pnp
.pnp.js

# Variables de entorno y credenciales (CRÍTICO)
.env
.env.*
*.env
**/.env
**/.env.*
!**/.env.example
!*.env.example

# Compilaciones de producción
dist/
dist-ssr/
build/
**/dist/
**/build/

# Registros y logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Archivos temporales y datos en ejecución
*.pid
*.seed
*.pid.lock
.temp/
temp/
tmp/

# Pruebas y reportes de cobertura
coverage/
*.lcov
.nyc_output

# Archivos de editores y del sistema operativo
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swo
*.swn
*~
.DS_Store
Thumbs.db
